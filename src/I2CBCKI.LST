                                ;invert equ 1    ;1 if we need to invert SDA output (OC used) 
                                ;--changed for MASM 4.0 from IF INVERT to IFDEF INVERT 
                                ;--so, you should just un-comment the 1st line if you want to 
                                ;  enable inversion with MASM 3 
                                ;i2c bus routines 
                                ;i2c device is connected to 8255 as follows: 
                                ;8255 port b (61h) bit 2 - SDA out 
                                ;8255 port b (61h) bit 3 - SCL 
                                ;8255 port c (62h) bit 4 - SDA in 
                                ;2k7 pull-up to SDA 
                                 
                                ;for 8255 chip, SDA out can be tied directly to I2C device. 
                                ;for 82c55 chip, with its strong "1" output current, 
                                ;I2C device must be connected via OC gate or just a 
                                ;transistor tied to port B bit 2 (and inversion must be used!) 
                                 
                                ;L.Yadrennikov jun, aug 2025, may, sep 2026 
                                 
                                public i2cwr 
                                public i2crd 
                                public i2c_stopreset 
                                 
 = 0061                         port_b           equ 61h 
 = 0062                         port_c           equ 62h 
 = 0002                         sda_out_position equ 2 
 = 0004                         sda_in_position  equ 4 
 = 0003                         scl_position     equ 3 
 = 0004                         sda_out_mask     equ 1 SHL sda_out_position 
 = 0010                         sda_in_mask      equ 1 SHL sda_in_position 
 = 0008                         scl_mask         equ 1 SHL scl_position 
                                 
                                SCL_HI macro             ;raise SCL 
                                       or  al,scl_mask 
                                       out dx,al 
                                       endm 
                                 
                                SCL_LO macro             ;fall SCL 
                                       and al,not scl_mask 
                                       out dx,al 
                                       endm 
                                 
                                SDA_HI macro             ;raise SDA 
                                ifdef invert 
                                       and al,not sda_out_mask 
                                else 
                                       or  al,sda_out_mask 
                                endif 
                                       out dx,al 
                                       endm 
                                 
                                SDA_LO macro             ;fall SDA 
                                ifdef invert 
                                       or  al,sda_out_mask 
                                else 
                                       and al,not sda_out_mask 
                                endif 
                                       out dx,al 
                                       endm 
                                 
                                I2C_STOP macro           ;issue stop condition 
                                       SDA_LO 
                                       SCL_HI 
                                       SDA_HI 
                                       endm 
                                 
                                I2C_START macro          ;issue start condition 
                                       SDA_LO 
                                       SCL_LO 
                                       endm 
                                 
 0000                           _TEXT segment word public 'CODE' 
                                assume cs:_TEXT 
                                 
 0000                           i2c_stopreset proc near 
                                ;Detect I2C harness (in-to-out connection) presence, 
                                ;and force i2c reset after undefined bus and/or device state 
                                ;or just generate STOP 
                                ;On call: 
                                ;   CY clear - detect harness, 9 SCLs, then stop 
                                ;   CY set   - Just stop 
                                ;On return: 
                                ;   CY set - no I2C harness 
 0000  50                              push ax 
 0001  51                              push cx 
 0002  52                              push dx 
 0003  BA 0061                         mov dx,port_b 
 0006  EC                              in al,dx 
 0007  72 27                           jc stopgen 
                                                         ;detect I2C harness 
 0009  0C 04                           or  al,sda_out_mask       ;SDA=1 
 000B  EE                              out dx,al 
 000C  E4 62                           in al,port_c 
 000E  24 10                           and al,sda_in_mask 
 0010  8A E0                           mov ah,al         ;keep 1st SDA read 
 0012  EC                              in al,dx          ;port_B 
 0013  24 FB                           and al,not sda_out_mask   ;SDA=0 
 0015  EE                              out dx,al 
 0016  E4 62                           in al,port_c 
 0018  24 10                           and al,sda_in_mask 
 001A  32 E0                           xor ah,al         ;1 if harness exists 
 001C  74 1F                           jz no_harness 
                                ;at this point,AL=0 means non-inverted harness 
 001E  EC                              in al,dx          ;port_B 
                                       SCL_LO 
 001F  24 F7                  1        and al,not scl_mask
 0021  EE                     1        out dx,al
                                       SDA_HI 
 0022  24 FB                  1        and al,not sda_out_mask
 0024  EE                     1        out dx,al
 0025  B9 0009                         mov cx,9 
 0028                           scloop: 
                                       SCL_HI 
 0028  0C 08                  1        or  al,scl_mask
 002A  EE                     1        out dx,al
                                       SCL_LO 
 002B  24 F7                  1        and al,not scl_mask
 002D  EE                     1        out dx,al
 002E  E2 F8                           loop scloop 
 0030                           stopgen: 
                                       I2C_STOP 
 0030  0C 04                  2        or  al,sda_out_mask
 0032  EE                     2        out dx,al
 0033  0C 08                  2        or  al,scl_mask
 0035  EE                     2        out dx,al
 0036  24 FB                  2        and al,not sda_out_mask
 0038  EE                     2        out dx,al
 0039                           stresexit: 
 0039  5A                              pop dx 
 003A  59                              pop cx 
 003B  58                              pop ax 
 003C  C3                              ret 
                                 
 003D                           no_harness: 
 003D  F9                              stc 
 003E  EB F9                           jmp short stresexit 
                                i2c_stopreset endp 
                                 
                                 
 0040                           i2cwr proc near 
                                ;Write AH to I2C device 
                                ;On call: 
                                ;   AH - byte for output to I2C device 
                                ;   CY clear - No start condition 
                                ;   CY set   - Start condition 
                                ;On return: 
                                ;   CY clear - All OK 
                                ;   CY set   - No acknowlege bit from device 
                                ;   AX destroyed 
 0040  53                              push bx 
 0041  51                              push cx 
 0042  52                              push dx 
 0043  9C                              pushf 
 0044  BA 0061                         mov dx,port_b 
 0047  EC                              in  al,dx 
 0048  24 F3                           and al,not (sda_out_mask or scl_mask) 
 004A  8A D8                           mov bl,al         ;save previous port with 0s at i2c pins 
                                 
 004C  B1 02                           mov cl,sda_out_position 
                                ifdef invert 
 004E  F6 D4                           not ah 
                                endif 
 0050  D2 C4                           rol ah,cl         ;now the highest bit for output to device 
                                                         ;is in proper position 
 0052  B9 0008                         mov cx,8          ;amount of bits to output 
 0055  9D                              popf 
 0056  73 09                           jnc i2cwr_loop 
                                ifdef invert 
 0058  0C 08                           or  al, scl_mask 
                                endif 
 005A  EE                              out dx,al         ;out idle state on i2c 
                                       I2C_START 
 005B  0C 04                  2        or  al,sda_out_mask
 005D  EE                     2        out dx,al
 005E  24 F7                  2        and al,not scl_mask
 0060  EE                     2        out dx,al
 0061                           i2cwr_loop: 
 0061  D0 C4                           rol ah,1 
 0063  B0 04                           mov al,sda_out_mask 
 0065  22 C4                           and al,ah         ;select proper bit 
 0067  0A C3                           or  al,bl         ;put proper DATA bit 
 0069  EE                              out dx,al         ;keep SCL low, out DATA 
                                       SCL_HI 
 006A  0C 08                  1        or  al,scl_mask
 006C  EE                     1        out dx,al
                                       SCL_LO 
 006D  24 F7                  1        and al,not scl_mask
 006F  EE                     1        out dx,al
 0070  E2 EF                           loop i2cwr_loop 
                                       SDA_HI 
 0072  24 FB                  1        and al,not sda_out_mask
 0074  EE                     1        out dx,al
                                ;caveat programmer! If the hardware is non-inverting, 
                                ;and we use inverting routine, then we will get "0" 
                                ;as if we get proper ACK bit, even if device is absent. 
                                ;But if we will always set SDA_OUT to 1, regardless of 
                                ;the inversion settings, on inverting hardware we will 
                                ;always get "0" as if we get proper ACK, even if device 
                                ;is absent. 
                                ;Proper way is to detect I2C harness, inverting or not, 
                                ;by asserting 1 and 0 and reading the results. 
                                ;Now I will put inversion-dependent check in assumption 
                                ;that the pair (routine,hardware) is proper, 
                                ;to be able to check device presence. 
                                       SCL_HI 
 0075  0C 08                  1        or  al,scl_mask
 0077  EE                     1        out dx,al
 0078  E4 62                           in  al,port_c     ;read acknowlege bit 
 007A  24 10                           and al,sda_in_mask 
 007C  8A E0                           mov ah,al 
 007E  EC                              in  al,dx         ;restore port values 
                                       SCL_LO 
 007F  24 F7                  1        and al,not scl_mask
 0081  EE                     1        out dx,al
 0082  F6 DC                           neg ah            ;1-ah, set CY if ACK<>0 
 0084  5A                              pop dx 
 0085  59                              pop cx 
 0086  5B                              pop bx 
 0087  C3                              ret 
                                i2cwr endp 
                                 
 0088                           i2crd proc near 
                                ;Read from I2C device to AH 
                                ;On call: 
                                ;   CY clear - Generate acknowlege bit 
                                ;   CY set   - Don't generate acknowlege bit 
                                ;On return: 
                                ;   AH - byte from I2C device 
                                ;   CY clear 
 0088  51                              push cx 
 0089  52                              push dx 
 008A  9C                              pushf 
 008B  BA 0061                         mov dx,port_b 
 008E  EC                              in  al,dx 
                                ifdef invert 
 008F  25 00F7                         and ax,00ffh and not scl_mask 
                                endif 
 0092  B9 0008                         mov cx,8          ;amount of bits to read 
                                       SDA_HI 
 0095  24 FB                  1        and al,not sda_out_mask
 0097  EE                     1        out dx,al
 0098                           i2crd_loop: 
                                       SCL_HI 
 0098  0C 08                  1        or  al,scl_mask
 009A  EE                     1        out dx,al
 009B  E4 62                           in  al,port_c     ;read next bit 
 009D  24 10                           and al,sda_in_mask 
 009F  F6 D8                           neg al            ;set CF=read bit 
 00A1  D0 D4                           rcl ah,1          ;put next bit from CF to AH 
 00A3  EC                              in  al,dx         ;restore port values 
                                       SCL_LO 
 00A4  24 F7                  1        and al,not scl_mask
 00A6  EE                     1        out dx,al
 00A7  E2 EF                           loop i2crd_loop 
 00A9  9D                              popf 
 00AA  72 03                           jc  rd_finshift   ;skip acknowlege byte if desired 
                                       SDA_LO            ;send acknowlege byte 
 00AC  0C 04                  1        or  al,sda_out_mask
 00AE  EE                     1        out dx,al
 00AF                           rd_finshift: 
                                       SCL_HI            ;9th clock in both cases (ack vs no ack) 
 00AF  0C 08                  1        or  al,scl_mask
 00B1  EE                     1        out dx,al
                                       SCL_LO 
 00B2  24 F7                  1        and al,not scl_mask
 00B4  EE                     1        out dx,al
 00B5  F8                              clc 
 00B6  5A                              pop dx 
 00B7  59                              pop cx 
 00B8  C3                              ret 
                                i2crd endp 
                                 
 00B9                           _TEXT ends 
                                 
                                end 

