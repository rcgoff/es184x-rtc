                                ;invert equ 1    ;1 if we need to invert SDA output (OC used) 
                                ;--changed for MASM 4.0 from IF INVERT to IFDEF INVERT 
                                ;--so, you should just un-comment the 1st line if you want to 
                                ;  enable inversion with MASM 3 
                                ;i2c bus routines 
                                ;i2c device is connected to 8255 as follows: 
                                ;8255 port b (61h) bit 2 - SDA out 
                                ;8255 port b (61h) bit 3 - SCL 
                                ;8255 port c (62h) bit 4 - SDA in 
                                ;2k7 pull-up to SDA 
                                 
                                ;for 8255 chip, SDA out can be tied directly to I2C device. 
                                ;for 82c55 chip, with its strong "1" output current, 
                                ;I2C device must be connected via OC gate or just a 
                                ;transistor tied to port B bit 2 (and inversion must be used!) 
                                 
                                ;L.Yadrennikov jun, aug 2025, may, sep 2026 
                                 
                                public i2cwr 
                                public i2crd 
                                public i2c_stopreset 
                                 
 = 0061                         port_b           equ 61h 
 = 0062                         port_c           equ 62h 
 = 0002                         sda_out_position equ 2 
 = 0004                         sda_in_position  equ 4 
 = 0003                         scl_position     equ 3 
 = 0004                         sda_out_mask     equ 1 SHL sda_out_position 
 = 0010                         sda_in_mask      equ 1 SHL sda_in_position 
 = 00F0                         sda_in_to_cf_add equ 100h-sda_in_mask 
 = 0008                         scl_mask         equ 1 SHL scl_position 
                                 
                                SCL_HI macro             ;raise SCL 
                                       or  al,scl_mask 
                                       out dx,al 
                                       endm 
                                 
                                SCL_LO macro             ;fall SCL 
                                       and al,not scl_mask 
                                       out dx,al 
                                       endm 
                                 
                                SDA_HI macro             ;raise SDA 
                                ifdef invert 
                                       and al,not sda_out_mask 
                                else 
                                       or  al,sda_out_mask 
                                endif 
                                       out dx,al 
                                       endm 
                                 
                                SDA_LO macro             ;fall SDA 
                                ifdef invert 
                                       or  al,sda_out_mask 
                                else 
                                       and al,not sda_out_mask 
                                endif 
                                       out dx,al 
                                       endm 
                                 
                                I2C_STOP macro           ;issue stop condition 
                                       SDA_LO 
                                       SCL_HI 
                                       SDA_HI 
                                       endm 
                                 
                                I2C_START macro          ;issue start condition 
                                       SDA_LO 
                                       SCL_LO 
                                       endm 
                                 
 0000                           _TEXT segment word public 'CODE' 
                                assume cs:_TEXT 
                                 
 0000                           i2c_stopreset proc near 
                                ;Force i2c reset after undefined bus and/or device state 
                                ;or just generate STOP 
                                ;On call: 
                                ;   CY clear - 9 SCLs, then stop 
                                ;   CY set   - Just stop 
                                ;On return: 
                                ;   Nothing 
 0000  50                              push ax 
 0001  51                              push cx 
 0002  52                              push dx 
 0003  BA 0061                         mov dx,port_b 
 0006  EC                              in al,dx 
 0007  72 11                           jc stopgen 
                                       SCL_LO 
 0009  24 F7                  1        and al,not scl_mask
 000B  EE                     1        out dx,al
                                       SDA_HI 
 000C  24 FB                  1        and al,not sda_out_mask
 000E  EE                     1        out dx,al
 000F  B9 0009                         mov cx,9 
 0012                           scloop: 
                                       SCL_HI 
 0012  0C 08                  1        or  al,scl_mask
 0014  EE                     1        out dx,al
                                       SCL_LO 
 0015  24 F7                  1        and al,not scl_mask
 0017  EE                     1        out dx,al
 0018  E2 F8                           loop scloop 
 001A                           stopgen: 
                                       I2C_STOP 
 001A  0C 04                  2        or  al,sda_out_mask
 001C  EE                     2        out dx,al
 001D  0C 08                  2        or  al,scl_mask
 001F  EE                     2        out dx,al
 0020  24 FB                  2        and al,not sda_out_mask
 0022  EE                     2        out dx,al
 0023  5A                              pop dx 
 0024  59                              pop cx 
 0025  58                              pop ax 
 0026  C3                              ret 
                                i2c_stopreset endp 
                                 
                                 
 0027                           i2cwr proc near 
                                ;Write AH to I2C device 
                                ;On call: 
                                ;   AH - byte for output to I2C device 
                                ;   CY clear - No start condition 
                                ;   CY set   - Start condition 
                                ;On return: 
                                ;   CY clear - All OK 
                                ;   CY set   - No acknowlege bit from device 
                                ;   AX destroyed 
 0027  53                              push bx 
 0028  51                              push cx 
 0029  52                              push dx 
 002A  9C                              pushf 
 002B  BA 0061                         mov dx,port_b 
 002E  EC                              in  al,dx 
 002F  24 F3                           and al,not (sda_out_mask or scl_mask) 
 0031  8A D8                           mov bl,al         ;save previous port with 0s at i2c pins 
                                 
 0033  B1 02                           mov cl,sda_out_position 
                                ifdef invert 
 0035  F6 D4                           not ah 
                                endif 
 0037  D2 C4                           rol ah,cl         ;now the highest bit for output to device 
                                                         ;is in proper position 
 0039  B9 0008                         mov cx,8          ;amount of bits to output 
 003C  9D                              popf 
 003D  73 09                           jnc i2cwr_loop 
                                ifdef invert 
 003F  0C 08                           or  al, scl_mask 
                                endif 
 0041  EE                              out dx,al         ;out idle state on i2c 
                                       I2C_START 
 0042  0C 04                  2        or  al,sda_out_mask
 0044  EE                     2        out dx,al
 0045  24 F7                  2        and al,not scl_mask
 0047  EE                     2        out dx,al
 0048                           i2cwr_loop: 
 0048  D0 C4                           rol ah,1 
 004A  B0 04                           mov al,sda_out_mask 
 004C  22 C4                           and al,ah         ;select proper bit 
 004E  0A C3                           or  al,bl         ;put proper DATA bit 
 0050  EE                              out dx,al         ;keep SCL low, out DATA 
                                       SCL_HI 
 0051  0C 08                  1        or  al,scl_mask
 0053  EE                     1        out dx,al
                                       SCL_LO 
 0054  24 F7                  1        and al,not scl_mask
 0056  EE                     1        out dx,al
 0057  E2 EF                           loop i2cwr_loop 
                                       SDA_HI 
 0059  24 FB                  1        and al,not sda_out_mask
 005B  EE                     1        out dx,al
                                ;caveat programmer! If the hardware is non-inverting, 
                                ;and we use inverting routine, then we will get "0" 
                                ;as if we get proper ACK bit, even if device is absent. 
                                ;But if we will always set SDA_OUT to 1, regardless of 
                                ;the inversion settings, on inverting hardware we will 
                                ;always get "0" as if we get proper ACK, even if device 
                                ;is absent. 
                                ;Proper way is to detect I2C harness, inverting or not, 
                                ;by asserting 1 and 0 and reading the results. 
                                ;Now I will put inversion-dependent check in assumption 
                                ;that the pair (routine,hardware) is proper, 
                                ;to be able to check device presence. 
                                       SCL_HI 
 005C  0C 08                  1        or  al,scl_mask
 005E  EE                     1        out dx,al
 005F  E4 62                           in  al,port_c     ;read acknowlege bit 
 0061  8A E0                           mov ah,al 
 0063  EC                              in  al,dx         ;restore port values 
                                       SCL_LO 
 0064  24 F7                  1        and al,not scl_mask
 0066  EE                     1        out dx,al
 0067  80 E4 10                        and ah,sda_in_mask 
 006A  F6 DC                           neg ah            ;1-ah, set CY if ACK<>0 
 006C  5A                              pop dx 
 006D  59                              pop cx 
 006E  5B                              pop bx 
 006F  C3                              ret 
                                i2cwr endp 
                                 
 0070                           i2crd proc near 
                                ;Read from I2C device to AH 
                                ;On call: 
                                ;   CY clear - Generate acknowlege bit 
                                ;   CY set   - Don't generate acknowlege bit 
                                ;On return: 
                                ;   AH - byte from I2C device 
                                ;   CY clear 
 0070  51                              push cx 
 0071  52                              push dx 
 0072  9C                              pushf 
 0073  BA 0061                         mov dx,port_b 
 0076  EC                              in  al,dx 
                                ifdef invert 
 0077  25 00F7                         and ax,00ffh and not scl_mask 
                                endif 
 007A  B9 0008                         mov cx,8          ;amount of bits to read 
                                       SDA_HI 
 007D  24 FB                  1        and al,not sda_out_mask
 007F  EE                     1        out dx,al
 0080                           i2crd_loop: 
                                       SCL_HI 
 0080  0C 08                  1        or  al,scl_mask
 0082  EE                     1        out dx,al
 0083  E4 62                           in  al,port_c     ;read next bit 
 0085  24 10                           and al,sda_in_mask 
 0087  04 F0                           add al,sda_in_to_cf_add  ;set CF=read bit 
 0089  D0 D4                           rcl ah,1          ;put next bit from CF to AH 
 008B  EC                              in  al,dx         ;restore port values 
                                       SCL_LO 
 008C  24 F7                  1        and al,not scl_mask
 008E  EE                     1        out dx,al
 008F  E2 EF                           loop i2crd_loop 
 0091  9D                              popf 
 0092  72 03                           jc  rd_finshift   ;skip acknowlege byte if desired 
                                       SDA_LO            ;send acknowlege byte 
 0094  0C 04                  1        or  al,sda_out_mask
 0096  EE                     1        out dx,al
 0097                           rd_finshift: 
                                       SCL_HI            ;9th clock in both cases (ack vs no ack) 
 0097  0C 08                  1        or  al,scl_mask
 0099  EE                     1        out dx,al
                                       SCL_LO 
 009A  24 F7                  1        and al,not scl_mask
 009C  EE                     1        out dx,al
 009D  F8                              clc 
 009E  5A                              pop dx 
 009F  59                              pop cx 
 00A0  C3                              ret 
                                i2crd endp 
                                 
 00A1                           _TEXT ends 
                                 
                                end 

