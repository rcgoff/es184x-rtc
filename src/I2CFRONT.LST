 = 0000                         debug  equ 0    ;1=debug mode (stand-alone program) 
 = 0001                         com    equ 1    ;1 if com file 
                                ;i2c bus routines (Front-end) 
                                 
                                ;L.Yadrennikov june-july 2025, sep-oct 2026 
                                 
                                public write_i2c_device 
                                public read_i2c_device 
                                extrn i2crd:near 
                                extrn i2cwr:near 
                                extrn i2c_stopreset:near 
                                 
 0000                           _TEXT segment byte public 'CODE' 
                                assume cs:_TEXT 
                                 
 0000                           write_i2c_device proc near 
                                ;Write byte array to I2C devices 
                                ;(sequental write) 
                                ;On call: 
                                ;   DS:SI - pointer to location of bytes to write 
                                ;   BX - initial address into device 
                                ;   CX - amount of bytes to write 
                                ;   CY clear - send 1-byte address to i2c 
                                ;   CY set   - send 2-byte address to i2c 
                                ;   AH - I2C device address 
                                ;On return: 
                                ;   CY clear - All OK 
                                ;   CY set   - No acknowlege bit from device 
 0000  52                              push dx 
 0001  8B D4                           mov dx,sp 
 0003  9C                              pushf 
 0004  F8                              clc               ;9 SCL, then stop 
 0005  E8 0000 E                       call i2c_stopreset 
 0008  72 2A                           jc i2cwrerr 
 000A  F9                              stc 
 000B  E8 0000 E                       call i2cwr        ;send dev addr from AH 
 000E  72 24                           jc i2cwrerr 
 0010  9D                              popf 
 0011  73 08                           jnc lowraddr 
 0013  8A E7                           mov ah,bh         ;internal addr-h 
 0015  F8                              clc 
 0016  E8 0000 E                       call i2cwr 
 0019  72 19                           jc i2cwrerr 
 001B                           lowraddr: 
 001B  8A E3                           mov ah,bl         ;internal addr-l 
 001D  E8 0000 E                       call i2cwr 
 0020  72 12                           jc i2cwrerr 
 0022  FC                              cld               ;autoincrement 
 0023                           arraywr_loop: 
 0023  AC                              lodsb 
 0024  8A E0                           mov ah,al 
 0026  E8 0000 E                       call i2cwr 
 0029  72 09                           jc i2cwrerr 
 002B  E2 F6                           loop arraywr_loop 
 002D  F9                              stc               ;stop condition 
 002E  E8 0000 E                       call i2c_stopreset 
 0031  5A                              pop dx 
 0032  F8                              clc 
 0033  C3                              ret 
                                 
 0034                           i2cwrerr: 
 0034  8B E2                           mov sp,dx 
 0036  5A                              pop dx 
 0037  F9                              stc 
 0038  C3                              ret 
                                write_i2c_device endp 
                                 
 0039                           read_i2c_device proc near 
                                ;Read byte array from I2C devices 
                                ;(sequental read) 
                                ;On call: 
                                ;   ES:DI - pointer to location of read bytes 
                                ;   BX - initial address into device 
                                ;   CX - amount of bytes to read 
                                ;   CY clear - send 1-byte address to i2c 
                                ;   CY set   - send 2-byte address to i2c 
                                ;   AH - I2C device address 
                                ;   AL<>0 - skip addres writing 
                                ;On return: 
                                ;   CY clear - All OK 
                                ;   CY set   - No acknowlege bit from device 
                                ;   AX,BP destroyed 
 0039  52                              push dx 
 003A  8B D4                           mov dx,sp 
 003C  50                              push ax 
 003D  1B ED                           sbb bp,bp         ;BP=Carry flag  (0 or FFh) 
 003F  F8                              clc 
 0040  E8 0000 E                       call i2c_stopreset 
 0043  72 3B                           jc i2crderr 
 0045  0A C0                           or al,al 
 0047  75 18                           jnz read 
 0049  F9                              stc 
 004A  E8 0000 E                       call i2cwr        ;send dev addr from AH 
 004D  72 31                           jc i2crderr 
 004F  45                              inc bp            ;now BP=0 if CF was 1 
 0050  75 08                           jnz lowrdaddr     ;equals jnc by saved CF 
 0052  8A E7                           mov ah,bh         ;internal addr-h 
 0054  F8                              clc 
 0055  E8 0000 E                       call i2cwr 
 0058  72 26                           jc i2crderr 
 005A                           lowrdaddr: 
 005A  8A E3                           mov ah,bl         ;internal addr-l 
 005C  E8 0000 E                       call i2cwr 
 005F  72 1F                           jc i2crderr 
 0061                           read: 
 0061  58                              pop ax            ;recall i2c device addr 
 0062  FE C4                           inc ah            ;form 'read' command 
 0064  F9                              stc 
 0065  E8 0000 E                       call i2cwr 
 0068  72 16                           jc i2crderr 
 006A  FC                              cld               ;autoincrement 
 006B  49                              dec cx 
 006C  74 08                           jz last_read 
 006E                           arrayrd_loop: 
 006E  E8 0000 E                       call i2crd 
 0071  8A C4                           mov al,ah 
 0073  AA                              stosb 
 0074  E2 F8                           loop arrayrd_loop 
 0076                           last_read: 
 0076  F9                              stc 
 0077  E8 0000 E                       call i2crd 
 007A  8A C4                           mov al,ah 
 007C  AA                              stosb 
 007D  5A                              pop dx 
 007E  F8                              clc 
 007F  C3                              ret 
                                 
 0080                           i2crderr: 
 0080  8B E2                           mov sp,dx 
 0082  5A                              pop dx 
 0083  F9                              stc 
 0084  C3                              ret 
                                read_i2c_device endp 
                                 
                                endif 
                                 
 0085                           _TEXT ends 
                                 
                                endif 
                                 
                                endif 
                                 
                                end 
