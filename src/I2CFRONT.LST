 = 0000                         debug  equ 0    ;1=debug mode (stand-alone program) 
 = 0001                         com    equ 1    ;1 if com file 
                                ;i2c bus routines (Front-end) 
                                 
                                ;L.Yadrennikov june-july 2025, sep-nov 2026 
                                 
                                public write_i2c_device 
                                public read_i2c_device 
                                extrn i2crd:near 
                                extrn i2cwr:near 
                                extrn i2c_stopreset:near 
                                 
 0000                           _TEXT segment byte public 'CODE' 
                                assume cs:_TEXT 
                                 
 0000                           write_i2c_device proc near 
                                ;Write byte array to I2C devices 
                                ;(sequental write) 
                                ;On call: 
                                ;   DS:SI - pointer to location of bytes to write 
                                ;   BX - initial address into device 
                                ;   CX - number of bytes to write ( >0 ) 
                                ;   CY clear - send 1-byte address to i2c 
                                ;   CY set   - send 2-byte address to i2c 
                                ;   AH - I2C device address 
                                ;On return: 
                                ;   CY clear - All OK 
                                ;   CY set   - No acknowlege bit from device 
 0000  52                              push dx 
 0001  1B D2                           sbb dx,dx         ;dx=CF (0 or FFh) 
 0003  F8                              clc               ;9 SCL, then stop 
 0004  E8 0000 E                       call i2c_stopreset 
 0007  72 2A                           jc i2cwrerr 
 0009  F9                              stc 
 000A  E8 0000 E                       call i2cwr        ;send dev addr from AH 
 000D  72 1E                           jc i2cwrerr2 
 000F  42                              inc dx            ;dx=0 if CF on call was 1 
 0010  75 08                           jnz lowraddr      ;equivalent of jnc for CF-on-call 
 0012  8A E7                           mov ah,bh         ;internal addr-h 
 0014  F8                              clc 
 0015  E8 0000 E                       call i2cwr 
 0018  72 13                           jc i2cwrerr2 
 001A                           lowraddr: 
 001A  8A E3                           mov ah,bl         ;internal addr-l 
 001C  E8 0000 E                       call i2cwr 
 001F  72 0C                           jc i2cwrerr2 
 0021  FC                              cld               ;autoincrement 
 0022                           arraywr_loop: 
 0022  AC                              lodsb 
 0023  8A E0                           mov ah,al 
 0025  E8 0000 E                       call i2cwr 
 0028  72 03                           jc i2cwrerr2 
 002A  E2 F6                           loop arraywr_loop 
 002C  F8                              clc               ;CF=0 is "no errors" flag 
 002D                           i2cwrerr2:               ;jump on NACK error always occurs by jc, so CF=1 
 002D  9C                              pushf 
 002E  F9                              stc               ;stop condition 
 002F  E8 0000 E                       call i2c_stopreset 
 0032  9D                              popf 
 0033                           i2cwrerr: 
 0033  5A                              pop dx 
 0034  C3                              ret 
                                write_i2c_device endp 
                                 
 0035                           read_i2c_device proc near 
                                ;Read byte array from I2C devices 
                                ;(sequental read) 
                                ;On call: 
                                ;   ES:DI - pointer to location of read bytes 
                                ;   BX - initial address into device 
                                ;   CX - number of bytes to read ( >0 ) 
                                ;   CY clear - send 1-byte address to i2c 
                                ;   CY set   - send 2-byte address to i2c 
                                ;   AH - I2C device address 
                                ;   AL<>0 - skip addres writing 
                                ;On return: 
                                ;   CY clear - All OK 
                                ;   CY set   - No acknowlege bit from device 
                                ;   AX,BP destroyed 
 0035  52                              push dx 
 0036  8B D0                           mov dx,ax 
 0038  1B ED                           sbb bp,bp         ;BP=Carry flag  (0 or FFh) 
 003A  F8                              clc 
 003B  E8 0000 E                       call i2c_stopreset 
 003E  72 40                           jc i2crderr 
 0040  0A C0                           or al,al 
 0042  75 18                           jnz read 
 0044  F9                              stc 
 0045  E8 0000 E                       call i2cwr        ;send dev addr from AH 
 0048  72 30                           jc i2crderr2 
 004A  45                              inc bp            ;now BP=0 if CF was 1 
 004B  75 08                           jnz lowrdaddr     ;equals jnc by saved CF 
 004D  8A E7                           mov ah,bh         ;internal addr-h 
 004F  F8                              clc 
 0050  E8 0000 E                       call i2cwr 
 0053  72 25                           jc i2crderr2 
 0055                           lowrdaddr: 
 0055  8A E3                           mov ah,bl         ;internal addr-l 
 0057  E8 0000 E                       call i2cwr 
 005A  72 1E                           jc i2crderr2 
 005C                           read: 
 005C  8B C2                           mov ax,dx         ;recall i2c device addr 
 005E  FE C4                           inc ah            ;form 'read' command 
 0060  F9                              stc 
 0061  E8 0000 E                       call i2cwr 
 0064  72 14                           jc i2crderr2 
 0066  FC                              cld               ;autoincrement 
 0067  49                              dec cx 
 0068  74 08                           jz last_read 
 006A                           arrayrd_loop: 
 006A  E8 0000 E                       call i2crd 
 006D  8A C4                           mov al,ah 
 006F  AA                              stosb 
 0070  E2 F8                           loop arrayrd_loop 
 0072                           last_read: 
 0072  F9                              stc 
 0073  E8 0000 E                       call i2crd 
 0076  8A C4                           mov al,ah 
 0078  AA                              stosb 
 0079  F8                              clc               ;CF=0 is "no errors" flag 
 007A                           i2crderr2:               ;jump on NACK error always occurs by jc, so CF=1 
 007A  9C                              pushf 
 007B  F9                              stc               ;stop condition 
 007C  E8 0000 E                       call i2c_stopreset 
 007F  9D                              popf 
 0080                           i2crderr: 
 0080  5A                              pop dx 
 0081  C3                              ret 
                                 
                                read_i2c_device endp 
                                 
                                endif 
                                 
 0082                           _TEXT ends 
                                 
                                endif 
                                 
                                endif 
                                 
                                end 
