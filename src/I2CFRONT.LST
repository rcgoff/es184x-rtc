 = 0000                         debug  equ 0    ;1=debug mode (stand-alone program) 
 = 0001                         com    equ 1    ;1 if com file 
                                ;i2c bus routines (Front-end) 
                                 
                                ;L.Yadrennikov june-july 2025, sep-oct 2026 
                                 
                                public write_i2c_device 
                                public read_i2c_device 
                                extrn i2crd:near 
                                extrn i2cwr:near 
                                extrn i2c_stopreset:near 
                                 
 0000                           _TEXT segment byte public 'CODE' 
                                assume cs:_TEXT 
                                 
 0000                           write_i2c_device proc near 
                                ;Write byte array to I2C devices 
                                ;(sequental write) 
                                ;On call: 
                                ;   DS:SI - pointer to location of bytes to write 
                                ;   BX - initial address into device 
                                ;   CX - number of bytes to write ( >0 ) 
                                ;   CY clear - send 1-byte address to i2c 
                                ;   CY set   - send 2-byte address to i2c 
                                ;   AH - I2C device address 
                                ;On return: 
                                ;   CY clear - All OK 
                                ;   CY set   - No acknowlege bit from device 
 0000  52                              push dx 
 0001  1B D2                           sbb dx,dx         ;dx=CF (0 or FFh) 
 0003  F8                              clc               ;9 SCL, then stop 
 0004  E8 0000 E                       call i2c_stopreset 
 0007  72 28                           jc i2cwrerr 
 0009  F9                              stc 
 000A  E8 0000 E                       call i2cwr        ;send dev addr from AH 
 000D  72 22                           jc i2cwrerr 
 000F  42                              inc dx            ;dx=0 if CF on call was 1 
 0010  75 08                           jnz lowraddr      ;equivalent of jnc for CF-on-call 
 0012  8A E7                           mov ah,bh         ;internal addr-h 
 0014  F8                              clc 
 0015  E8 0000 E                       call i2cwr 
 0018  72 17                           jc i2cwrerr 
 001A                           lowraddr: 
 001A  8A E3                           mov ah,bl         ;internal addr-l 
 001C  E8 0000 E                       call i2cwr 
 001F  72 10                           jc i2cwrerr 
 0021  FC                              cld               ;autoincrement 
 0022                           arraywr_loop: 
 0022  AC                              lodsb 
 0023  8A E0                           mov ah,al 
 0025  E8 0000 E                       call i2cwr 
 0028  72 07                           jc i2cwrerr 
 002A  E2 F6                           loop arraywr_loop 
 002C  F9                              stc               ;stop condition 
 002D  E8 0000 E                       call i2c_stopreset 
 0030  F8                              clc 
 0031                           i2cwrerr:                ;jump to i2cwrerr alays occurs by jc, so CF=1 
 0031  5A                              pop dx 
 0032  C3                              ret 
                                write_i2c_device endp 
                                 
 0033                           read_i2c_device proc near 
                                ;Read byte array from I2C devices 
                                ;(sequental read) 
                                ;On call: 
                                ;   ES:DI - pointer to location of read bytes 
                                ;   BX - initial address into device 
                                ;   CX - number of bytes to read ( >0 ) 
                                ;   CY clear - send 1-byte address to i2c 
                                ;   CY set   - send 2-byte address to i2c 
                                ;   AH - I2C device address 
                                ;   AL<>0 - skip addres writing 
                                ;On return: 
                                ;   CY clear - All OK 
                                ;   CY set   - No acknowlege bit from device 
                                ;   AX,BP destroyed 
 0033  52                              push dx 
 0034  8B D0                           mov dx,ax 
 0036  1B ED                           sbb bp,bp         ;BP=Carry flag  (0 or FFh) 
 0038  F8                              clc 
 0039  E8 0000 E                       call i2c_stopreset 
 003C  72 3E                           jc i2crderr 
 003E  0A C0                           or al,al 
 0040  75 18                           jnz read 
 0042  F9                              stc 
 0043  E8 0000 E                       call i2cwr        ;send dev addr from AH 
 0046  72 34                           jc i2crderr 
 0048  45                              inc bp            ;now BP=0 if CF was 1 
 0049  75 08                           jnz lowrdaddr     ;equals jnc by saved CF 
 004B  8A E7                           mov ah,bh         ;internal addr-h 
 004D  F8                              clc 
 004E  E8 0000 E                       call i2cwr 
 0051  72 29                           jc i2crderr 
 0053                           lowrdaddr: 
 0053  8A E3                           mov ah,bl         ;internal addr-l 
 0055  E8 0000 E                       call i2cwr 
 0058  72 22                           jc i2crderr 
 005A                           read: 
 005A  8B C2                           mov ax,dx         ;recall i2c device addr 
 005C  FE C4                           inc ah            ;form 'read' command 
 005E  F9                              stc 
 005F  E8 0000 E                       call i2cwr 
 0062  72 18                           jc i2crderr 
 0064  FC                              cld               ;autoincrement 
 0065  49                              dec cx 
 0066  74 08                           jz last_read 
 0068                           arrayrd_loop: 
 0068  E8 0000 E                       call i2crd 
 006B  8A C4                           mov al,ah 
 006D  AA                              stosb 
 006E  E2 F8                           loop arrayrd_loop 
 0070                           last_read: 
 0070  F9                              stc 
 0071  E8 0000 E                       call i2crd 
 0074  8A C4                           mov al,ah 
 0076  AA                              stosb 
 0077  F9                              stc               ;stop condition 
 0078  E8 0000 E                       call i2c_stopreset 
 007B  F8                              clc 
 007C                           i2crderr:                ;jump to i2crderr alays occurs by jc, so CF=1 
 007C  5A                              pop dx 
 007D  C3                              ret 
                                read_i2c_device endp 
                                 
                                endif 
                                 
 007E                           _TEXT ends 
                                 
                                endif 
                                 
                                endif 
                                 
                                end 
