                                        public  bin_to_bcd 
                                        public  bcd_to_bin 
                                assume cs:_TEXT 
 0000                           _TEXT segment word public 'CODE' 
                                 
 0000                           bin_to_bcd      proc    near            ; real time clock sup 
                                ;Convert a binary input in AL (less than 63h or 99 decimal) 
                                ;into a bcd value in AL.  AH destroyed. 
                                ;LY this is from MSINIT.ASM DOS 3.3 
 0000  51                               push    cx 
 0001  32 E4                            xor     ah, ah 
 0003  B1 0A                            mov     cl, 10 
 0005  F6 F1                            div     cl              ;al=high digit bcd, ah=low digit bcd 
 0007  B1 04                            mov     cl, 4 
 0009  D2 E0                            shl     al, cl          ;mov the high digit to high nibble 
 000B  0A C4                            or      al, ah 
 000D  59                               pop     cx 
 000E  C3                               ret 
                                bin_to_bcd      endp 
                                 
 000F                           bcd_to_bin      proc    near            ; real time clock sup 
                                ; 
                                ;   Bcd_to_bin converts two bcd nibbles in al (value <= 99.) to 
                                ;   a binary representation in al 
                                ;   ah is destroyed 
                                ; 
                                ;LY this if from READCLOC.INC DOS 3.3 
 000F  51                               push    cx 
 0010  8A E0                            mov     ah,al           ;mjb002 copy bcd number to ah 
 0012  25 F00F                          and     ax,0f00fh       ;mjb002 clear unwanted nibbles 
 0015  8A E8                            mov     ch,al           ;mjb002 save units place 
 0017  86 E0                            xchg    ah,al           ;mjb002 10's place to al 
 0019  32 E4                            xor     ah,ah           ;mjb002 ah not wanted 
 001B  B1 04                            mov     cl,4            ;mjb002 shift count 
 001D  D3 E8                            shr     ax,cl           ;mjb004 swap nibbles 
 001F  B1 0A                            mov     cl,10           ;mjb002 convert al to ... 
 0021  F6 E1                            mul     cl              ;mjb002 ... its binary value 
 0023  02 C5                            add     al,ch           ;mjb002 add in units 
 0025  59                               pop     cx 
 0026  C3                               ret                     ;mjb002 
                                bcd_to_bin      endp 
 0027                           _TEXT ends 
                                end 
