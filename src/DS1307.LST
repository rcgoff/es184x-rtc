 0268  BF 00F6                         mov di,offset buf2+6 
 026B  BE 00E6                         mov si,offset buf1+6 
 026E  F3/ A6                          repe cmpsb       ;compare from year downto seconds 
 0270  F8                              clc 
 0271                           check_running_error: 
 0271  C3                              ret 
                                check_running endp 
                                 
 0272                           bin_to_bcd      proc    near 
                                ;Convert a binary input in AL (less than 63h or 99 decimal) 
                                ;into a bcd value in AL.  AH destroyed. 
                                ; 
 0272  D4 0A                            aam             ;ah=high digit bcd, al=low digit bcd 
 0274  D5                               db   0d5h 
 0275  10                               db   10h        ;it's AAD with 10h base,al=bcd digit, ah=0 
 0276  C3                               ret 
                                bin_to_bcd      endp 
                                 
 0277                           bcd_to_bin      proc    near 
                                ; 
                                ;   Bcd_to_bin converts two bcd nibbles in al (value <= 99.) to 
                                ;   a binary representation in al 
                                ;   ah is set to 00h if conversion ok 
                                ;   if source is wrong, al=0ffh on exit 
 0277  3C A0                            cmp  al,0a0h    ;test for higher BCD digit validity 
 0279  73 09                            jae  bad_bcd 
 027B  D4                               db   0d4h 
 027C  10                               db   10h        ;AAM with 10h base,ah=higher digit,al=lower one 
 027D  3C 0A                            cmp  al,10d     ;test for lower BCD digit validity 
 027F  73 03                            jae  bad_bcd 
 0281  D5 0A                            aad             ;bcd2bin in al, 00 in ah 
 0283  C3                               ret 
 0284                           bad_bcd: 
 0284  B0 FF                            mov  al,0ffh 
 0286  C3                               ret 
                                bcd_to_bin      endp 
                                 
