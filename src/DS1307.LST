 0244                           delay_2sec proc near 
                                ;wait for 2 sec to ensure that RTC is running 
                                ;2 sec instead of 1 to prevent asyncronity... 
                                ;...of PC and RTC seconds' change issues. 
                                ;3 cases are possible: 
                                ;linear seconds increment 
                                ;59->0->1     1-59=-58 
                                ;58->59->0    0-58=-58 
                                ;so, if we get negative number (check by JC),we should add 60 
 0244  B4 2C                           mov ah,2ch 
 0246  CD 21                           int 21h          ;get time,seconds in dh 
 0248  8A DE                           mov bl,dh 
 024A  CD 21                    dloop: int 21h 
 024C  2A F3                           sub dh,bl 
 024E  72 06                           jc add60 
 0250  80 FE 02                 dcmp:  cmp dh,2 
 0253  72 F5                           jb  dloop 
 0255  C3                              ret 
                                 
 0256  80 C6 3C                 add60: add dh,60d 
 0259  EB F5                           jmp short dcmp 
                                delay_2sec endp 
                                 
 025B                           check_running proc near 
                                ;returns ZF if comparison results are the same (RTC isn't runnning) 
                                ;returns CF if RTC read error 
                                ;CX on returns shows the byte where comparison fails or 0 if all the same 
 025B  E8 0244 R                       call delay_2sec 
 025E  BF 00F0                         mov di,offset buf2 
 0261  E8 0237 R                       call read_ds1307 
 0264  72 0D                           jc check_running_error 
