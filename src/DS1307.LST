 0242                           delay_2sec proc near 
                                ;wait for 2 sec to ensure that RTC is running 
                                ;2 sec instead of 1 to prevent asyncronity... 
                                ;...of PC and RTC seconds' change issues. 
                                ;3 cases are possible: 
                                ;linear seconds increment 
                                ;59->0->1     1-59=-58 
                                ;58->59->0    0-58=-58 
                                ;so, if we get negative number (check by JC),we should add 60 
 0242  B4 2C                           mov ah,2ch 
 0244  CD 21                           int 21h          ;get time,seconds in dh 
 0246  8A DE                           mov bl,dh 
 0248  CD 21                    dloop: int 21h 
 024A  2A F3                           sub dh,bl 
 024C  72 06                           jc add60 
 024E  80 FE 02                 dcmp:  cmp dh,2 
 0251  72 F5                           jb  dloop 
 0253  C3                              ret 
                                 
 0254  80 C6 3C                 add60: add dh,60d 
 0257  EB F5                           jmp short dcmp 
                                delay_2sec endp 
                                 
 0259                           check_running proc near 
                                ;returns ZF if comparison results are the same (RTC isn't runnning) 
