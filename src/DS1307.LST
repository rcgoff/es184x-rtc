 024A                           delay_2sec proc near 
                                ;wait for 2 sec to ensure that RTC is running 
                                ;2 sec instead of 1 to prevent asyncronity... 
                                ;...of PC and RTC seconds' change issues. 
                                ;3 cases are possible: 
                                ;linear seconds increment 
                                ;59->0->1     1-59=-58 
                                ;58->59->0    0-58=-58 
                                ;so, if we get negative number (check by JC),we should add 60 
 024A  B4 2C                           mov ah,2ch 
 024C  CD 21                           int 21h          ;get time,seconds in dh 
 024E  8A DE                           mov bl,dh 
 0250  CD 21                    dloop: int 21h 
 0252  2A F3                           sub dh,bl 
 0254  72 06                           jc add60 
 0256  80 FE 02                 dcmp:  cmp dh,2 
 0259  75 F5                           jnz dloop 
 025B  C3                              ret 
                                 
 025C  80 C6 3C                 add60: add dh,60d 
 025F  EB F5                           jmp short dcmp 
                                delay_2sec endp 
                                 
