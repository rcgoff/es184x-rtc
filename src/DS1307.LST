 026C  F3/ A6                          repe cmpsb       ;compare from year downto seconds 
 026E  F8                              clc 
 026F                           check_running_error: 
 026F  C3                              ret 
                                check_running endp 
                                 
 0270                           bin_to_bcd      proc    near 
                                ;Convert a binary input in AL (less than 63h or 99 decimal) 
                                ;into a bcd value in AL.  AH destroyed. 
                                ; 
 0270  D4 0A                            aam             ;ah=high digit bcd, al=low digit bcd 
 0272  D5                               db   0d5h 
 0273  10                               db   10h        ;it's AAD with 10h base,al=bcd digit, ah=0 
 0274  C3                               ret 
                                bin_to_bcd      endp 
                                 
 0275                           bcd_to_bin      proc    near 
                                ; 
                                ;   Bcd_to_bin converts two bcd nibbles in al (value <= 99.) to 
                                ;   a binary representation in al 
                                ;   ah is set to 00h if conversion ok 
                                ;   if source is wrong, al=0ffh on exit 
 0275  3C A0                            cmp  al,0a0h    ;test for higher BCD digit validity 
 0277  73 09                            jae  bad_bcd 
 0279  D4                               db   0d4h 
 027A  10                               db   10h        ;AAM with 10h base,ah=higher digit,al=lower one 
 027B  3C 0A                            cmp  al,10d     ;test for lower BCD digit validity 
 027D  73 03                            jae  bad_bcd 
 027F  D5 0A                            aad             ;bcd2bin in al, 00 in ah 
 0281  C3                               ret 
 0282                           bad_bcd: 
 0282  B0 FF                            mov  al,0ffh 
 0284  C3                               ret 
                                bcd_to_bin      endp 
                                 
