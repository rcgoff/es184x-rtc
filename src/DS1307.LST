                                ;Real-time clock set-reset based on DS1307/DS3231 chip 
                                ;L.Yadrennikov june-september 2025, sep-nov 2026 
                                 
                                ;DOS functions for time/date 
                                ;int 21h, AH=2Ah. get system date. 
                                ;int 21h, AH=2Bh. set system date. 
                                ;Date format for both functions: 
                                ;CX=year (1980-2099) 
                                ;DH=month (1-12) 
                                ;DL=day (1-31) 
                                 
                                ;2Ah (get date) returns: 
                                ;AL=day of week (0-6, 0-sunday) 
                                ;2Bh (set date) returns: 
                                ;AL=00 for valid date, FF for invalid. 
                                 
                                ;int 21h, AH=2Ch. get system time. 
                                ;int 21h, AH=2Dh. set system time. 
                                ;Time format: 
                                ;CH=hours (0-23) 
                                ;CL=minutes (0-59) 
                                ;DH=seconds (0-59) 
                                ;DL=hundredths of seconds (0-99) 
                                 
                                ;2Ch (get time) returns nothing 
                                ;2Dh (set time) returns: 
                                ;AL=00 for valid time, FF for invalid. 
                                 
                                ;time/date is stored in DS1307 and DS3231 as follows: 
                                ;The format is BCD 
                                ;Byte - Value 
                                ;0 Seconds (bit7=1 switches oscillator off) 
                                ;1 Minutes 
                                ;2 Hours (bit6=1 12hour mode, if so, bit5=1 PM) 
                                ;3 Day of week 
                                ;4 Day of month 
                                ;5 Month (in DS3231 bit7=1 is century byte) 
                                ;6 Year 
                                ;7 Control word 
                                ;8...3F - RAM. 
                                 
 = 000D                         cr       equ   0dh 
 = 000A                         lf       equ   0ah 
 = 0080                         cmd      equ   80h     ;command line tail 
 = 00E0                         buf1     equ   0e0h    ;buffer for reading from RTC 
 = 00F0                         buf2     equ   0f0h    ;buffer for comparing 
 = 0001                         stdout   equ   1 
 = 0002                         stderr   equ   2 
                                 
                                extrn write_i2c_device:near 
                                extrn read_i2c_device:near 
                                extrn argc:near 
                                extrn argv:near 
                                 
                                TO_BUFF macro 
                                ;convert AL to bcd and write to buff 
                                       call bin_to_bcd 
                                       stosb 
                                       endm 
                                 
                                FROM_BUFF macro 
                                ;read buff to AL, convert from bcd to bin 
                                       lodsb 
                                       call bcd_to_bin 
                                       endm 
                                 
