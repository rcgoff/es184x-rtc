 026A  BF 00F6                         mov di,offset buf2+6 
 026D  BE 00E6                         mov si,offset buf1+6 
 0270  F3/ A6                          repe cmpsb       ;compare from year downto seconds 
 0272  F8                              clc 
 0273                           check_running_error: 
 0273  C3                              ret 
                                check_running endp 
                                 
 0274                           bin_to_bcd      proc    near 
                                ;Convert a binary input in AL (less than 63h or 99 decimal) 
                                ;into a bcd value in AL.  AH destroyed. 
                                ; 
 0274  D4 0A                            aam             ;ah=high digit bcd, al=low digit bcd 
 0276  D5                               db   0d5h 
 0277  10                               db   10h        ;it's AAD with 10h base,al=bcd digit, ah=0 
 0278  C3                               ret 
                                bin_to_bcd      endp 
                                 
 0279                           bcd_to_bin      proc    near 
                                ; 
                                ;   Bcd_to_bin converts two bcd nibbles in al (value <= 99.) to 
                                ;   a binary representation in al 
                                ;   ah is set to 00h if conversion ok 
                                ;   if source is wrong, al=0ffh on exit 
 0279  3C A0                            cmp  al,0a0h    ;test for higher BCD digit validity 
 027B  73 09                            jae  bad_bcd 
 027D  D4                               db   0d4h 
 027E  10                               db   10h        ;AAM with 10h base,ah=higher digit,al=lower one 
 027F  3C 0A                            cmp  al,10d     ;test for lower BCD digit validity 
 0281  73 03                            jae  bad_bcd 
 0283  D5 0A                            aad             ;bcd2bin in al, 00 in ah 
 0285  C3                               ret 
 0286                           bad_bcd: 
 0286  B0 FF                            mov  al,0ffh 
 0288  C3                               ret 
                                bcd_to_bin      endp 
                                 
