                                ;i2c bus routines 
                                ;i2c device is connected to 8255 as follows: 
                                ;8255 port b (61h) bit 2 - SDA out 
                                ;8255 port b (61h) bit 3 - SCL 
                                ;8255 port c (62h) bit 4 - SDA in 
                                ;2k7 pull-up to SDA 
                                 
                                ;for 8255 chip, SDA out can be tied directly to I2C device. 
                                ;for 82c55 chip, with its strong "1" output current, 
                                ;I2C device must be connected via OC gate or just a 
                                ;transistor tied to port B bit 2 (and inversion must be used!) 
                                ;both inverted and non-inverted connection supported by this code 
                                 
                                ;L.Yadrennikov jun, aug 2025, may, sep-nov 2026 
                                 
                                public i2cwr 
                                public i2crd 
                                public i2c_stopreset 
                                 
 = 0061                         port_b           equ 61h 
 = 0062                         port_c           equ 62h 
 = 0002                         sda_out_position equ 2 
 = 0004                         sda_in_position  equ 4 
 = 0003                         scl_position     equ 3 
 = 0004                         sda_out_mask     equ 1 SHL sda_out_position 
 = 0010                         sda_in_mask      equ 1 SHL sda_in_position 
 = 0008                         scl_mask         equ 1 SHL scl_position 
                                 
                                SCL_HI macro             ;raise SCL 
                                       or  al,scl_mask 
                                       out dx,al 
                                       endm 
                                 
                                SCL_LO macro             ;fall SCL 
                                       and al,not scl_mask 
                                       out dx,al 
                                       endm 
                                 
                                I2C_STOP macro           ;issue stop condition 
                                       call sda_lo 
                                       SCL_HI 
                                       call sda_hi 
                                       endm 
                                 
                                I2C_START macro          ;issue start condition 
                                       call sda_lo 
                                       SCL_LO 
                                       endm 
                                 
 0000                           _DATA segment at 0h      ;data segment is PSP 
 00EF                                  org 0efh 
 00EF  ??                              inversion_mask db ? 
 00F0                           _DATA ends 
                                 
 0000                           _TEXT segment word public 'CODE' 
                                assume cs:_TEXT,ds:_DATA 
                                 
 0000                           i2c_stopreset proc near 
                                ;Detect I2C harness (in-to-out connection) presence, 
                                ;and force i2c reset after undefined bus and/or device state 
                                ;or just generate STOP 
                                ;On call: 
                                ;   CY clear - detect harness, 2x9 SCLs, then stop 
                                ;   CY set   - Just stop 
                                ;On return: 
                                ;   CY set - no I2C harness 
                                ;   inversion_mask kept in memory 
 0000  50                              push ax 
 0001  51                              push cx 
 0002  52                              push dx 
 0003  BA 0061                         mov dx,port_b 
 0006  EC                              in al,dx 
 0007  72 36                           jc stopgen 
 0009  50                              push ax           ;keep original port_b value 
                                       SCL_LO 
 000A  24 F7                  1        and al,not scl_mask
 000C  EE                     1        out dx,al
 000D  0C 04                           or al,sda_out_mask 
                                                         ;do 9scl-and-stop twice with sda=1 and then with sda=0 
 000F                           nine_scl_reset: 
 000F  EE                              out dx,al 
 0010  B9 0009                         mov cx,9 
 0013                           scloop: 
                                       SCL_HI 
 0013  0C 08                  1        or  al,scl_mask
 0015  EE                     1        out dx,al
                                       SCL_LO 
 0016  24 F7                  1        and al,not scl_mask
 0018  EE                     1        out dx,al
 0019  E2 F8                           loop scloop 
 001B  34 04                           xor al,sda_out_mask 
 001D  A8 04                           test al,sda_out_mask 
 001F  74 EE                           jz nine_scl_reset 
 0021  EE                              out dx,al 
                                                         ;detect I2C harness, now SDA physically=1 
 0022  E4 62                           in al,port_c 
 0024  24 10                           and al,sda_in_mask 
 0026  8A E0                           mov ah,al         ;keep 1st SDA read 
 0028  EC                              in al,dx          ;port_B 
 0029  24 FB                           and al,not sda_out_mask   ;SDA=0 
 002B  EE                              out dx,al 
 002C  E4 62                           in al,port_c 
 002E  24 10                           and al,sda_in_mask 
 0030  32 E0                           xor ah,al         ;1 if harness exists 
 0032  74 18                           jz no_harness 
                                ;at this point,AL=0 means non-inverted harness 
 0034  04 F0                           add al,100h-sda_in_mask   ;CY=1 means inverted harness 
 0036  1A C0                           sbb al,al                 ;AL=FFh means inverted harness 
 0038  24 04                           and al,sda_out_mask       ;now 'AL XOR databit' ready for inv/noninv 
 003A  A2 00EF R                       mov inversion_mask,al     ;keep it in memory 
 003D  58                              pop ax            ;stack balance 
 003E  EC                              in al,dx          ;port_B 
 003F                           stopgen: 
                                       I2C_STOP 
 003F  E8 0051 R              1        call sda_lo
 0042  0C 08                  2        or  al,scl_mask
 0044  EE                     2        out dx,al
 0045  E8 0055 R              1        call sda_hi
 0048                           stresexit: 
 0048  5A                              pop dx 
 0049  59                              pop cx 
 004A  58                              pop ax 
 004B  C3                              ret 
                                 
 004C                           no_harness: 
 004C  58                              pop ax            ;recall original port_b value 
 004D  EE                              out dx,al         ;restore it 
 004E  F9                              stc 
 004F  EB F7                           jmp short stresexit 
                                i2c_stopreset endp 
                                 
 0051                           sda_set proc near 
 0051                           sda_lo:                          ;fall SDA 
 0051  24 FB                           and al,not sda_out_mask   ;prepare 0 
 0053  EB 02                           jmp short sda_set_common 
                                ;       xor al,inversion_mask     ;if inv_mask=1 then inverted 
                                                                 ;0xor1=1 0xor0=0 
                                ;       out dx,al 
                                ;       ret 
                                 
 0055                           sda_hi:                          ;raise SDA 
 0055  0C 04                           or  al,sda_out_mask       ;prepare 1 
 0057                           sda_set_common: 
 0057  32 06 00EF R                    xor al,inversion_mask     ;if inv_mask=1 then inverted 
                                                                 ;1xor1=0 1xor0=1 
 005B  EE                              out dx,al 
 005C  C3                              ret 
                                 
                                sda_set endp 
                                 
                                 
 005D                           i2cwr proc near 
                                ;Write AH to I2C device 
                                ;On call: 
                                ;   AH - byte for output to I2C device 
                                ;   CY clear - No start condition 
                                ;   CY set   - Start condition 
                                ;On return: 
                                ;   CY clear - All OK 
                                ;   CY set   - No acknowlege bit from device 
                                ;   AX destroyed 
 005D  53                              push bx 
 005E  51                              push cx 
 005F  52                              push dx 
 0060  BA 0061                         mov dx,port_b 
 0063  EC                              in  al,dx 
 0064  73 0D                           jnc i2cwr_setup 
 0066  0C 0C                           or  al, (scl_mask or sda_out_mask) 
 0068  32 06 00EF R                    xor al,inversion_mask    ;set sda_out_mask=0 if invert (1xor1=0) 
 006C  EE                              out dx,al         ;out idle state on i2c 
                                       I2C_START 
 006D  E8 0051 R              1        call sda_lo
 0070  24 F7                  2        and al,not scl_mask
 0072  EE                     2        out dx,al
 0073                           i2cwr_setup: 
 0073  24 F3                           and al,not (sda_out_mask or scl_mask) 
 0075  8A D8                           mov bl,al         ;save previous port with 0s at i2c pins 
 0077  B9 0008                         mov cx,8          ;bits to output 
 007A  F6 06 00EF R 04                 test inversion_mask,sda_out_mask     ;return 1 if inverted 
 007F  74 02                           jz i2cwr_loop 
 0081  F6 D4                           not ah 
 0083                           i2cwr_loop: 
 0083  D0 C4                           rol ah,1          ;next bit to CF 
 0085  1A C0                           sbb al,al         ;al=0ffh if CF=next bit=1 
 0087  24 04                           and al,sda_out_mask   ;select proper bit 
 0089  0A C3                           or  al,bl         ;put proper DATA bit 
 008B  EE                              out dx,al         ;keep SCL low, out DATA 
                                       SCL_HI 
 008C  0C 08                  1        or  al,scl_mask
 008E  EE                     1        out dx,al
                                       SCL_LO 
 008F  24 F7                  1        and al,not scl_mask
 0091  EE                     1        out dx,al
 0092  E2 EF                           loop i2cwr_loop 
 0094  E8 0055 R                       call sda_hi 
                                       SCL_HI 
 0097  0C 08                  1        or  al,scl_mask
 0099  EE                     1        out dx,al
 009A  E4 62                           in  al,port_c     ;read acknowlege bit 
 009C  24 10                           and al,sda_in_mask 
 009E  8A E0                           mov ah,al 
 00A0  EC                              in  al,dx         ;restore port values 
                                       SCL_LO 
 00A1  24 F7                  1        and al,not scl_mask
 00A3  EE                     1        out dx,al
 00A4  F6 DC                           neg ah            ;1-ah, set CY if ACK<>0 
 00A6  5A                              pop dx 
 00A7  59                              pop cx 
 00A8  5B                              pop bx 
 00A9  C3                              ret 
                                i2cwr endp 
                                 
 00AA                           i2crd proc near 
                                ;Read from I2C device to AH 
                                ;On call: 
                                ;   CY clear - Generate acknowlege bit 
                                ;   CY set   - Don't generate acknowlege bit 
                                ;   Assumed that SCL is LOW, device already selected 
                                ;On return: 
                                ;   AH - byte from I2C device 
                                ;   CY clear 
 00AA  51                              push cx 
 00AB  52                              push dx 
 00AC  9C                              pushf 
 00AD  BA 0061                         mov dx,port_b 
 00B0  EC                              in  al,dx 
                                ;       and ax,00ffh and not scl_mask 
 00B1  B9 0008                         mov cx,8          ;number of bits to read 
 00B4  E8 0055 R                       call sda_hi 
 00B7                           i2crd_loop: 
                                       SCL_HI 
 00B7  0C 08                  1        or  al,scl_mask
 00B9  EE                     1        out dx,al
 00BA  E4 62                           in  al,port_c     ;read next bit 
 00BC  24 10                           and al,sda_in_mask 
 00BE  F6 D8                           neg al            ;set CF=read bit 
 00C0  D0 D4                           rcl ah,1          ;put next bit from CF to AH 
 00C2  EC                              in  al,dx         ;restore port values 
                                       SCL_LO 
 00C3  24 F7                  1        and al,not scl_mask
 00C5  EE                     1        out dx,al
 00C6  E2 EF                           loop i2crd_loop 
 00C8  9D                              popf 
 00C9  72 03                           jc  rd_finshift   ;skip acknowlege byte if desired 
 00CB  E8 0051 R                       call sda_lo       ;send acknowlege byte 
 00CE                           rd_finshift: 
                                       SCL_HI            ;9th clock in both cases (ack vs no ack) 
 00CE  0C 08                  1        or  al,scl_mask
 00D0  EE                     1        out dx,al
                                       SCL_LO 
 00D1  24 F7                  1        and al,not scl_mask
 00D3  EE                     1        out dx,al
 00D4  F8                              clc 
 00D5  5A                              pop dx 
 00D6  59                              pop cx 
 00D7  C3                              ret 
                                i2crd endp 
                                 
 00D8                           _TEXT ends 
                                 
                                end 

