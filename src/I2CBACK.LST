                                ;i2c bus routines 
                                ;i2c device is connected to 8255 as follows: 
                                ;8255 port b (61h) bit 2 - SDA out 
                                ;8255 port b (61h) bit 3 - SCL 
                                ;8255 port c (62h) bit 4 - SDA in 
                                ;2k7 pull-up to SDA 
                                 
                                ;for 8255 chip, SDA out can be tied directly to I2C device. 
                                ;for 82c55 chip, with its strong "1" output current, 
                                ;I2C device must be connected via OC gate or just a 
                                ;transistor tied to port B bit 2 (and inversion must be used!) 
                                 
                                ;L.Yadrennikov jun, aug 2025, may, sep 2026 
                                 
                                public i2cwr 
                                public i2crd 
                                public i2c_stopreset 
                                 
 = 0061                         port_b           equ 61h 
 = 0062                         port_c           equ 62h 
 = 0002                         sda_out_position equ 2 
 = 0004                         sda_in_position  equ 4 
 = 0003                         scl_position     equ 3 
 = 0004                         sda_out_mask     equ 1 SHL sda_out_position 
 = 0010                         sda_in_mask      equ 1 SHL sda_in_position 
 = 0008                         scl_mask         equ 1 SHL scl_position 
                                 
                                SCL_HI macro             ;raise SCL 
                                       or  al,scl_mask 
                                       out dx,al 
                                       endm 
                                 
                                SCL_LO macro             ;fall SCL 
                                       and al,not scl_mask 
                                       out dx,al 
                                       endm 
                                 
                                I2C_STOP macro           ;issue stop condition 
                                       call sda_lo 
                                       SCL_HI 
                                       call sda_hi 
                                       endm 
                                 
                                I2C_START macro          ;issue start condition 
                                       call sda_lo 
                                       SCL_LO 
                                       endm 
                                 
 0000                           _DATA segment at 0h      ;data segment is PSP 
 00EF                                  org 0efh 
 00EF  ??                              inversion_mask db ? 
 00F0                           _DATA ends 
                                 
 0000                           _TEXT segment word public 'CODE' 
                                assume cs:_TEXT,ds:_DATA 
                                 
 0000                           i2c_stopreset proc near 
                                ;Detect I2C harness (in-to-out connection) presence, 
                                ;and force i2c reset after undefined bus and/or device state 
                                ;or just generate STOP 
                                ;On call: 
                                ;   CY clear - detect harness, 9 SCLs, then stop 
                                ;   CY set   - Just stop 
                                ;On return: 
                                ;   CY set - no I2C harness 
 0000  50                              push ax 
 0001  51                              push cx 
 0002  52                              push dx 
 0003  BA 0061                         mov dx,port_b 
 0006  EC                              in al,dx 
 0007  72 30                           jc stopgen 
                                                         ;detect I2C harness 
 0009  0C 04                           or  al,sda_out_mask       ;SDA=1 
 000B  EE                              out dx,al 
 000C  E4 62                           in al,port_c 
 000E  24 10                           and al,sda_in_mask 
 0010  8A E0                           mov ah,al         ;keep 1st SDA read 
 0012  EC                              in al,dx          ;port_B 
 0013  24 FB                           and al,not sda_out_mask   ;SDA=0 
 0015  EE                              out dx,al 
 0016  E4 62                           in al,port_c 
 0018  24 10                           and al,sda_in_mask 
 001A  32 E0                           xor ah,al         ;1 if harness exists 
 001C  74 28                           jz no_harness 
                                ;at this point,AL=0 means non-inverted harness 
 001E  04 F0                           add al,100h-sda_in_mask   ;CY=1 means inverted harness 
 0020  1A C0                           sbb al,al                 ;AL=FFh means inverted harness 
 0022  24 04                           and al,sda_out_mask       ;now 'AL XOR databit' ready for inv/noninv 
 0024  A2 00EF R                       mov inversion_mask,al     ;keep it in memory 
                                ;9 SCL and stop 
 0027  EC                              in al,dx          ;port_B 
                                       SCL_LO 
 0028  24 F7                  1        and al,not scl_mask
 002A  EE                     1        out dx,al
 002B  E8 004D R                       call sda_hi 
 002E  B9 0009                         mov cx,9 
 0031                           scloop: 
                                       SCL_HI 
 0031  0C 08                  1        or  al,scl_mask
 0033  EE                     1        out dx,al
                                       SCL_LO 
 0034  24 F7                  1        and al,not scl_mask
 0036  EE                     1        out dx,al
 0037  E2 F8                           loop scloop 
 0039                           stopgen: 
                                       I2C_STOP 
 0039  E8 0049 R              1        call sda_lo
 003C  0C 08                  2        or  al,scl_mask
 003E  EE                     2        out dx,al
 003F  E8 004D R              1        call sda_hi
 0042                           stresexit: 
 0042  5A                              pop dx 
 0043  59                              pop cx 
 0044  58                              pop ax 
 0045  C3                              ret 
                                 
 0046                           no_harness: 
 0046  F9                              stc 
 0047  EB F9                           jmp short stresexit 
                                i2c_stopreset endp 
                                 
 0049                           sda_set proc near 
 0049                           sda_lo:                          ;fall SDA 
 0049  24 FB                           and al,not sda_out_mask   ;prepare 0 
 004B  EB 02                           jmp short sda_set_common 
                                ;       xor al,inversion_mask     ;if inv_mask=1 then inverted 
                                                                 ;0xor1=1 0xor0=0 
                                ;       out dx,al 
                                ;       ret 
                                 
 004D                           sda_hi:                          ;raise SDA 
 004D  0C 04                           or  al,sda_out_mask       ;prepare 1 
 004F                           sda_set_common: 
 004F  32 06 00EF R                    xor al,inversion_mask     ;if inv_mask=1 then inverted 
                                                                 ;1xor1=0 1xor0=1 
 0053  EE                              out dx,al 
 0054  C3                              ret 
                                 
                                sda_set endp 
                                 
                                 
 0055                           i2cwr proc near 
                                ;Write AH to I2C device 
                                ;On call: 
                                ;   AH - byte for output to I2C device 
                                ;   CY clear - No start condition 
                                ;   CY set   - Start condition 
                                ;On return: 
                                ;   CY clear - All OK 
                                ;   CY set   - No acknowlege bit from device 
                                ;   AX destroyed 
 0055  53                              push bx 
 0056  51                              push cx 
 0057  52                              push dx 
 0058  9C                              pushf 
 0059  BA 0061                         mov dx,port_b 
 005C  EC                              in  al,dx 
 005D  24 F3                           and al,not (sda_out_mask or scl_mask) 
 005F  8A D8                           mov bl,al         ;save previous port with 0s at i2c pins 
                                 
 0061  B1 02                           mov cl,sda_out_position 
 0063  F6 06 00EF R 04                 test inversion_mask,sda_out_mask     ;return 1 if inverted 
 0068  74 02                           jz rdy_for_write 
 006A  F6 D4                           not ah 
 006C                           rdy_for_write: 
 006C  D2 C4                           rol ah,cl         ;now the highest bit for output to device... 
                                                         ;...is in proper position 
 006E  B9 0008                         mov cx,8          ;number of bits to output 
 0071  9D                              popf 
 0072  73 0D                           jnc i2cwr_loop 
 0074  0C 0C                           or  al, (scl_mask or sda_out_mask) 
 0076  32 06 00EF R                    xor al,inversion_mask    ;set sda_out_mask=0 if invert (1xor1=0) 
 007A  EE                              out dx,al         ;out idle state on i2c 
                                       I2C_START 
 007B  E8 0049 R              1        call sda_lo
 007E  24 F7                  2        and al,not scl_mask
 0080  EE                     2        out dx,al
 0081                           i2cwr_loop: 
 0081  D0 C4                           rol ah,1 
 0083  B0 04                           mov al,sda_out_mask 
 0085  22 C4                           and al,ah         ;select proper bit 
 0087  0A C3                           or  al,bl         ;put proper DATA bit 
 0089  EE                              out dx,al         ;keep SCL low, out DATA 
                                       SCL_HI 
 008A  0C 08                  1        or  al,scl_mask
 008C  EE                     1        out dx,al
                                       SCL_LO 
 008D  24 F7                  1        and al,not scl_mask
 008F  EE                     1        out dx,al
 0090  E2 EF                           loop i2cwr_loop 
 0092  E8 004D R                       call sda_hi 
                                       SCL_HI 
 0095  0C 08                  1        or  al,scl_mask
 0097  EE                     1        out dx,al
 0098  E4 62                           in  al,port_c     ;read acknowlege bit 
 009A  24 10                           and al,sda_in_mask 
 009C  8A E0                           mov ah,al 
 009E  EC                              in  al,dx         ;restore port values 
                                       SCL_LO 
 009F  24 F7                  1        and al,not scl_mask
 00A1  EE                     1        out dx,al
 00A2  F6 DC                           neg ah            ;1-ah, set CY if ACK<>0 
 00A4  5A                              pop dx 
 00A5  59                              pop cx 
 00A6  5B                              pop bx 
 00A7  C3                              ret 
                                i2cwr endp 
                                 
 00A8                           i2crd proc near 
                                ;Read from I2C device to AH 
                                ;On call: 
                                ;   CY clear - Generate acknowlege bit 
                                ;   CY set   - Don't generate acknowlege bit 
                                ;On return: 
                                ;   AH - byte from I2C device 
                                ;   CY clear 
 00A8  51                              push cx 
 00A9  52                              push dx 
 00AA  9C                              pushf 
 00AB  BA 0061                         mov dx,port_b 
 00AE  EC                              in  al,dx 
                                ;       and ax,00ffh and not scl_mask 
 00AF  B9 0008                         mov cx,8          ;number of bits to read 
 00B2  E8 004D R                       call sda_hi 
 00B5                           i2crd_loop: 
                                       SCL_HI 
 00B5  0C 08                  1        or  al,scl_mask
 00B7  EE                     1        out dx,al
 00B8  E4 62                           in  al,port_c     ;read next bit 
 00BA  24 10                           and al,sda_in_mask 
 00BC  F6 D8                           neg al            ;set CF=read bit 
 00BE  D0 D4                           rcl ah,1          ;put next bit from CF to AH 
 00C0  EC                              in  al,dx         ;restore port values 
                                       SCL_LO 
 00C1  24 F7                  1        and al,not scl_mask
 00C3  EE                     1        out dx,al
 00C4  E2 EF                           loop i2crd_loop 
 00C6  9D                              popf 
 00C7  72 03                           jc  rd_finshift   ;skip acknowlege byte if desired 
 00C9  E8 0049 R                       call sda_lo       ;send acknowlege byte 
 00CC                           rd_finshift: 
                                       SCL_HI            ;9th clock in both cases (ack vs no ack) 
 00CC  0C 08                  1        or  al,scl_mask
 00CE  EE                     1        out dx,al
                                       SCL_LO 
 00CF  24 F7                  1        and al,not scl_mask
 00D1  EE                     1        out dx,al
 00D2  F8                              clc 
 00D3  5A                              pop dx 
 00D4  59                              pop cx 
 00D5  C3                              ret 
                                i2crd endp 
                                 
 00D6                           _TEXT ends 
                                 
                                end 

