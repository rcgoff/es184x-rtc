                                ;i2c bus routines 
                                ;i2c device is connected to 8255 as follows: 
                                ;8255 port b (61h) bit 2 - SDA out 
                                ;8255 port b (61h) bit 3 - SCL 
                                ;8255 port c (62h) bit 4 - SDA in 
                                ;2k7 pull-up to SDA 
                                 
                                ;for 8255 chip, SDA out can be tied directly to I2C device. 
                                ;for 82c55 chip, with its strong "1" output current, 
                                ;I2C device must be connected via OC gate or just a 
                                ;transistor tied to port B bit 2 (and inversion must be used!) 
                                ;both inverted and non-inverted connection supported by this code 
                                 
                                ;L.Yadrennikov jun, aug 2025, may, sep, oct 2026 
                                 
                                public i2cwr 
                                public i2crd 
                                public i2c_stopreset 
                                 
 = 0061                         port_b           equ 61h 
 = 0062                         port_c           equ 62h 
 = 0002                         sda_out_position equ 2 
 = 0004                         sda_in_position  equ 4 
 = 0003                         scl_position     equ 3 
 = 0004                         sda_out_mask     equ 1 SHL sda_out_position 
 = 0010                         sda_in_mask      equ 1 SHL sda_in_position 
 = 0008                         scl_mask         equ 1 SHL scl_position 
                                 
                                SCL_HI macro             ;raise SCL 
                                       or  al,scl_mask 
                                       out dx,al 
                                       endm 
                                 
                                SCL_LO macro             ;fall SCL 
                                       and al,not scl_mask 
                                       out dx,al 
                                       endm 
                                 
                                I2C_STOP macro           ;issue stop condition 
                                       call sda_lo 
                                       SCL_HI 
                                       call sda_hi 
                                       endm 
                                 
                                I2C_START macro          ;issue start condition 
                                       call sda_lo 
                                       SCL_LO 
                                       endm 
                                 
 0000                           _DATA segment at 0h      ;data segment is PSP 
 00EF                                  org 0efh 
 00EF  ??                              inversion_mask db ? 
 00F0                           _DATA ends 
                                 
 0000                           _TEXT segment word public 'CODE' 
                                assume cs:_TEXT,ds:_DATA 
                                 
 0000                           i2c_stopreset proc near 
                                ;Detect I2C harness (in-to-out connection) presence, 
                                ;and force i2c reset after undefined bus and/or device state 
                                ;or just generate STOP 
                                ;On call: 
                                ;   CY clear - detect harness, 2x9 SCLs, then stop 
                                ;   CY set   - Just stop 
                                ;On return: 
                                ;   CY set - no I2C harness 
 0000  50                              push ax 
 0001  51                              push cx 
 0002  52                              push dx 
 0003  BA 0061                         mov dx,port_b 
 0006  EC                              in al,dx 
 0007  72 34                           jc stopgen 
                                       SCL_LO 
 0009  24 F7                  1        and al,not scl_mask
 000B  EE                     1        out dx,al
 000C  0C 04                           or al,sda_out_mask 
                                                         ;do 9scl-and-stop twice with sda=1 and then with sda=0 
 000E                           nine_scl_reset: 
 000E  EE                              out dx,al 
 000F  B9 0009                         mov cx,9 
 0012                           scloop: 
                                       SCL_HI 
 0012  0C 08                  1        or  al,scl_mask
 0014  EE                     1        out dx,al
                                       SCL_LO 
 0015  24 F7                  1        and al,not scl_mask
 0017  EE                     1        out dx,al
 0018  E2 F8                           loop scloop 
 001A  34 04                           xor al,sda_out_mask 
 001C  A8 04                           test al,sda_out_mask 
 001E  74 EE                           jz nine_scl_reset 
 0020  EE                              out dx,al 
                                                         ;detect I2C harness, now SDA physically=1 
 0021  E4 62                           in al,port_c 
 0023  24 10                           and al,sda_in_mask 
 0025  8A E0                           mov ah,al         ;keep 1st SDA read 
 0027  EC                              in al,dx          ;port_B 
 0028  24 FB                           and al,not sda_out_mask   ;SDA=0 
 002A  EE                              out dx,al 
 002B  E4 62                           in al,port_c 
 002D  24 10                           and al,sda_in_mask 
 002F  32 E0                           xor ah,al         ;1 if harness exists 
 0031  74 17                           jz no_harness 
                                ;at this point,AL=0 means non-inverted harness 
 0033  04 F0                           add al,100h-sda_in_mask   ;CY=1 means inverted harness 
 0035  1A C0                           sbb al,al                 ;AL=FFh means inverted harness 
 0037  24 04                           and al,sda_out_mask       ;now 'AL XOR databit' ready for inv/noninv 
 0039  A2 00EF R                       mov inversion_mask,al     ;keep it in memory 
 003C  EC                              in al,dx          ;port_B 
 003D                           stopgen: 
                                       I2C_STOP 
 003D  E8 004D R              1        call sda_lo
 0040  0C 08                  2        or  al,scl_mask
 0042  EE                     2        out dx,al
 0043  E8 0051 R              1        call sda_hi
 0046                           stresexit: 
 0046  5A                              pop dx 
 0047  59                              pop cx 
 0048  58                              pop ax 
 0049  C3                              ret 
                                 
 004A                           no_harness: 
 004A  F9                              stc 
 004B  EB F9                           jmp short stresexit 
                                i2c_stopreset endp 
                                 
 004D                           sda_set proc near 
 004D                           sda_lo:                          ;fall SDA 
 004D  24 FB                           and al,not sda_out_mask   ;prepare 0 
 004F  EB 02                           jmp short sda_set_common 
                                ;       xor al,inversion_mask     ;if inv_mask=1 then inverted 
                                                                 ;0xor1=1 0xor0=0 
                                ;       out dx,al 
                                ;       ret 
                                 
 0051                           sda_hi:                          ;raise SDA 
 0051  0C 04                           or  al,sda_out_mask       ;prepare 1 
 0053                           sda_set_common: 
 0053  32 06 00EF R                    xor al,inversion_mask     ;if inv_mask=1 then inverted 
                                                                 ;1xor1=0 1xor0=1 
 0057  EE                              out dx,al 
 0058  C3                              ret 
                                 
                                sda_set endp 
                                 
                                 
 0059                           i2cwr proc near 
                                ;Write AH to I2C device 
                                ;On call: 
                                ;   AH - byte for output to I2C device 
                                ;   CY clear - No start condition 
                                ;   CY set   - Start condition 
                                ;On return: 
                                ;   CY clear - All OK 
                                ;   CY set   - No acknowlege bit from device 
                                ;   AX destroyed 
 0059  53                              push bx 
 005A  51                              push cx 
 005B  52                              push dx 
 005C  BA 0061                         mov dx,port_b 
 005F  EC                              in  al,dx 
 0060  73 0D                           jnc i2cwr_setup 
 0062  0C 0C                           or  al, (scl_mask or sda_out_mask) 
 0064  32 06 00EF R                    xor al,inversion_mask    ;set sda_out_mask=0 if invert (1xor1=0) 
 0068  EE                              out dx,al         ;out idle state on i2c 
                                       I2C_START 
 0069  E8 004D R              1        call sda_lo
 006C  24 F7                  2        and al,not scl_mask
 006E  EE                     2        out dx,al
 006F                           i2cwr_setup: 
 006F  24 F3                           and al,not (sda_out_mask or scl_mask) 
 0071  8A D8                           mov bl,al         ;save previous port with 0s at i2c pins 
 0073  B9 0008                         mov cx,8          ;bits to output 
 0076  F6 06 00EF R 04                 test inversion_mask,sda_out_mask     ;return 1 if inverted 
 007B  74 02                           jz i2cwr_loop 
 007D  F6 D4                           not ah 
 007F                           i2cwr_loop: 
 007F  D0 C4                           rol ah,1          ;next bit to CF 
 0081  1A C0                           sbb al,al         ;al=0ffh if CF=next bit=1 
 0083  24 04                           and al,sda_out_mask   ;select proper bit 
 0085  0A C3                           or  al,bl         ;put proper DATA bit 
 0087  EE                              out dx,al         ;keep SCL low, out DATA 
                                       SCL_HI 
 0088  0C 08                  1        or  al,scl_mask
 008A  EE                     1        out dx,al
                                       SCL_LO 
 008B  24 F7                  1        and al,not scl_mask
 008D  EE                     1        out dx,al
 008E  E2 EF                           loop i2cwr_loop 
 0090  E8 0051 R                       call sda_hi 
                                       SCL_HI 
 0093  0C 08                  1        or  al,scl_mask
 0095  EE                     1        out dx,al
 0096  E4 62                           in  al,port_c     ;read acknowlege bit 
 0098  24 10                           and al,sda_in_mask 
 009A  8A E0                           mov ah,al 
 009C  EC                              in  al,dx         ;restore port values 
                                       SCL_LO 
 009D  24 F7                  1        and al,not scl_mask
 009F  EE                     1        out dx,al
 00A0  F6 DC                           neg ah            ;1-ah, set CY if ACK<>0 
 00A2  5A                              pop dx 
 00A3  59                              pop cx 
 00A4  5B                              pop bx 
 00A5  C3                              ret 
                                i2cwr endp 
                                 
 00A6                           i2crd proc near 
                                ;Read from I2C device to AH 
                                ;On call: 
                                ;   CY clear - Generate acknowlege bit 
                                ;   CY set   - Don't generate acknowlege bit 
                                ;   Assumed that SCL is LOW, device already selected 
                                ;On return: 
                                ;   AH - byte from I2C device 
                                ;   CY clear 
 00A6  51                              push cx 
 00A7  52                              push dx 
 00A8  9C                              pushf 
 00A9  BA 0061                         mov dx,port_b 
 00AC  EC                              in  al,dx 
                                ;       and ax,00ffh and not scl_mask 
 00AD  B9 0008                         mov cx,8          ;number of bits to read 
 00B0  E8 0051 R                       call sda_hi 
 00B3                           i2crd_loop: 
                                       SCL_HI 
 00B3  0C 08                  1        or  al,scl_mask
 00B5  EE                     1        out dx,al
 00B6  E4 62                           in  al,port_c     ;read next bit 
 00B8  24 10                           and al,sda_in_mask 
 00BA  F6 D8                           neg al            ;set CF=read bit 
 00BC  D0 D4                           rcl ah,1          ;put next bit from CF to AH 
 00BE  EC                              in  al,dx         ;restore port values 
                                       SCL_LO 
 00BF  24 F7                  1        and al,not scl_mask
 00C1  EE                     1        out dx,al
 00C2  E2 EF                           loop i2crd_loop 
 00C4  9D                              popf 
 00C5  72 03                           jc  rd_finshift   ;skip acknowlege byte if desired 
 00C7  E8 004D R                       call sda_lo       ;send acknowlege byte 
 00CA                           rd_finshift: 
                                       SCL_HI            ;9th clock in both cases (ack vs no ack) 
 00CA  0C 08                  1        or  al,scl_mask
 00CC  EE                     1        out dx,al
                                       SCL_LO 
 00CD  24 F7                  1        and al,not scl_mask
 00CF  EE                     1        out dx,al
 00D0  F8                              clc 
 00D1  5A                              pop dx 
 00D2  59                              pop cx 
 00D3  C3                              ret 
                                i2crd endp 
                                 
 00D4                           _TEXT ends 
                                 
                                end 

