                                ;invert equ 1    ;1 if we need to invert SDA output (OC used) 
                                ;--changed for MASM 4.0 from IF INVERT to IFDEF INVERT 
                                ;--so, you should just un-comment the 1st line if you want to 
                                ;  enable inversion with MASM 3 
                                ;i2c bus routines 
                                ;i2c device is connected to 8255 as follows: 
                                ;8255 port b (61h) bit 2 - SDA out 
                                ;8255 port b (61h) bit 3 - SCL 
                                ;8255 port c (62h) bit 4 - SDA in 
                                ;2k7 pull-up to SDA 
                                 
                                ;for 8255 chip, SDA out can be tied directly to I2C device. 
                                ;for 82c55 chip, with its strong "1" output current, 
                                ;I2C device must be connected via OC gate or just a 
                                ;transistor tied to port B bit 2 (and inversion must be used!) 
                                 
                                ;L.Yadrennikov june, august 2025, may 2026 
                                 
                                public i2cwr 
                                public i2crd 
                                public i2c_stopreset 
                                 
 = 0061                         port_b           equ 61h 
 = 0062                         port_c           equ 62h 
 = 0002                         sda_out_position equ 2 
 = 0004                         sda_in_position  equ 4 
 = 0004                         sda_out_mask     equ 1 SHL sda_out_position 
 = 0010                         sda_in_mask      equ 1 SHL sda_in_position 
 = 0008                         scl_mask         equ 00001000b 
                                 
                                SCL_HI macro             ;raise SCL 
                                       or  al,scl_mask 
                                       out dx,al 
                                       endm 
                                 
                                SCL_LO macro             ;fall SCL 
                                       and al,not scl_mask 
                                       out dx,al 
                                       endm 
                                 
                                SDA_HI macro             ;raise SDA 
                                ifdef invert 
                                       and al,not sda_out_mask 
                                else 
                                       or  al,sda_out_mask 
                                endif 
                                       out dx,al 
                                       endm 
                                 
                                SDA_LO macro             ;fall SDA 
                                ifdef invert 
                                       or  al,sda_out_mask 
                                else 
                                       and al,not sda_out_mask 
                                endif 
                                       out dx,al 
                                       endm 
                                 
                                I2C_STOP macro           ;issue stop condition 
                                       SDA_LO 
                                       SCL_HI 
                                       SDA_HI 
                                       endm 
                                 
                                I2C_START macro          ;issue start condition 
                                       SDA_LO 
                                       SCL_LO 
                                       endm 
                                 
 0000                           _TEXT segment word public 'CODE' 
                                assume cs:_TEXT 
                                 
 0000                           i2c_stopreset proc near 
                                ;Force i2c reset after undefined bus and/or device state 
                                ;or just generate STOP 
                                ;On call: 
                                ;   CY clear - 9 SCLs, then stop 
                                ;   CY set   - Just stop 
                                ;On return: 
                                ;   Nothing 
 0000  50                              push ax 
 0001  51                              push cx 
 0002  52                              push dx 
 0003  BA 0061                         mov dx,port_b 
 0006  EC                              in al,dx 
 0007  72 11                           jc stopgen 
                                       SCL_LO 
 0009  24 F7                  1        and al,not scl_mask
 000B  EE                     1        out dx,al
                                       SDA_HI 
 000C  0C 04                  1        or  al,sda_out_mask
 000E  EE                     1        out dx,al
 000F  B9 0009                         mov cx,9 
 0012                           scloop: 
                                       SCL_HI 
 0012  0C 08                  1        or  al,scl_mask
 0014  EE                     1        out dx,al
                                       SCL_LO 
 0015  24 F7                  1        and al,not scl_mask
 0017  EE                     1        out dx,al
 0018  E2 F8                           loop scloop 
 001A                           stopgen: 
                                       I2C_STOP 
 001A  24 FB                  2        and al,not sda_out_mask
 001C  EE                     2        out dx,al
 001D  0C 08                  2        or  al,scl_mask
 001F  EE                     2        out dx,al
 0020  0C 04                  2        or  al,sda_out_mask
 0022  EE                     2        out dx,al
 0023  5A                              pop dx 
 0024  59                              pop cx 
 0025  58                              pop ax 
 0026  C3                              ret 
                                i2c_stopreset endp 
                                 
                                 
 0027                           i2cwr proc near 
                                ;Write AH to I2C device 
                                ;On call: 
                                ;   AH - byte for output to I2C device 
                                ;   CY clear - No start condition 
                                ;   CY set   - Start condition 
                                ;On return: 
                                ;   CY clear - All OK 
                                ;   CY set   - No acknowlege bit from device 
 0027  50                              push ax 
 0028  53                              push bx 
 0029  51                              push cx 
 002A  52                              push dx 
 002B  9C                              pushf 
 002C  BA 0061                         mov dx,port_b 
 002F  EC                              in  al,dx 
 0030  24 F3                           and al,not (sda_out_mask or scl_mask) 
 0032  8A D8                           mov bl,al         ;save previous port with 0s at i2c pins 
                                 
 0034  B1 02                           mov cl,sda_out_position 
                                endif 
 0036  D2 C4                           rol ah,cl         ;now the highest bit for output to device 
                                                         ;is in proper position 
 0038  B9 0008                         mov cx,8          ;amount of bits to output 
 003B  9D                              popf 
 003C  73 09                           jnc i2cwr_loop 
                                else 
 003E  0C 0C                           or  al, (scl_mask or sda_out_mask) 
                                endif 
 0040  EE                              out dx,al         ;out idle state on i2c 
                                       I2C_START 
 0041  24 FB                  2        and al,not sda_out_mask
 0043  EE                     2        out dx,al
 0044  24 F7                  2        and al,not scl_mask
 0046  EE                     2        out dx,al
 0047                           i2cwr_loop: 
 0047  D0 C4                           rol ah,1 
 0049  B0 04                           mov al,sda_out_mask 
 004B  22 C4                           and al,ah         ;select proper bit 
 004D  0A C3                           or  al,bl         ;put proper DATA bit 
 004F  EE                              out dx,al         ;keep SCL low, out DATA 
                                       SCL_HI 
 0050  0C 08                  1        or  al,scl_mask
 0052  EE                     1        out dx,al
                                       SCL_LO 
 0053  24 F7                  1        and al,not scl_mask
 0055  EE                     1        out dx,al
 0056  E2 EF                           loop i2cwr_loop 
 0058  0C 04                           or  al,sda_out_mask     ;put SDA pin high regardless of inversion settings 
 005A  EE                              out dx,al 
                                       SCL_HI 
 005B  0C 08                  1        or  al,scl_mask
 005D  EE                     1        out dx,al
 005E  E4 62                           in  al,port_c     ;read acknowlege bit 
 0060  8A E0                           mov ah,al 
 0062  EC                              in  al,dx         ;restore port values 
                                       SCL_LO 
 0063  24 F7                  1        and al,not scl_mask
 0065  EE                     1        out dx,al
 0066  F8                              clc 
 0067  80 E4 10                        and ah,sda_in_mask 
 006A  74 01                           jz  wrexit 
 006C  F9                              stc               ;error if Ack<>0 
 006D                           wrexit: 
 006D  5A                              pop dx 
 006E  59                              pop cx 
 006F  5B                              pop bx 
 0070  58                              pop ax 
 0071  C3                              ret 
                                i2cwr endp 
                                 
 0072                           i2crd proc near 
                                ;Read from I2C device to AH 
                                ;On call: 
                                ;   CY clear - Generate acknowlege bit 
                                ;   CY set   - Don't generate acknowlege bit 
                                ;On return: 
                                ;   AH - byte from I2C device 
                                ;   CY clear 
 0072  53                              push bx 
 0073  51                              push cx 
 0074  52                              push dx 
 0075  9C                              pushf 
 0076  BA 0061                         mov dx,port_b 
 0079  EC                              in  al,dx 
                                else 
 007A  25 00F3                         and ax,00ffh and not (sda_out_mask or scl_mask) 
                                endif 
 007D  B3 10                           mov bl,sda_in_mask 
 007F  B9 0008                         mov cx,8          ;amount of bits to read 
 0082                           i2crd_loop: 
 0082  D0 C4                           rol ah,1 
                                       SDA_HI 
 0084  0C 04                  1        or  al,sda_out_mask
 0086  EE                     1        out dx,al
                                       SCL_HI 
 0087  0C 08                  1        or  al,scl_mask
 0089  EE                     1        out dx,al
 008A  E4 62                           in  al,port_c     ;read next bit 
 008C  22 C3                           and al,bl 
 008E  0A E0                           or  ah,al 
 0090  EC                              in  al,dx         ;restore port values 
                                       SCL_LO 
 0091  24 F7                  1        and al,not scl_mask
 0093  EE                     1        out dx,al
 0094  E2 EC                           loop i2crd_loop 
 0096  9D                              popf 
 0097  72 03                           jc  rd_finshift   ;skip acknowlege byte if desired 
                                       SDA_LO            ;send acknowlege byte 
 0099  24 FB                  1        and al,not sda_out_mask
 009B  EE                     1        out dx,al
 009C                           rd_finshift: 
                                       SCL_HI            ;9th clock in both cases (ack vs no ack) 
 009C  0C 08                  1        or  al,scl_mask
 009E  EE                     1        out dx,al
                                       SCL_LO 
 009F  24 F7                  1        and al,not scl_mask
 00A1  EE                     1        out dx,al
 00A2  B1 04                           mov cl,sda_in_position 
 00A4  D2 C4                           rol ah,cl         ;now the highest bit from device 
                                                         ;is in proper position 
 00A6                           rdexit: 
 00A6  F8                              clc 
 00A7  5A                              pop dx 
 00A8  59                              pop cx 
 00A9  5B                              pop bx 
 00AA  C3                              ret 
                                i2crd endp 
                                 
 00AB                           _TEXT ends 
                                 
                                end 

